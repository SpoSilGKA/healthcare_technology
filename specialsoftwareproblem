3. TypeScript Implementation
TypeScript provides explicit type safety for the simulated database structures.
typescript
interface Database {
    DPT: Record<number, string>;
    DIC: { lastId: number };
}

function fixSequence(db: Database): Database {
    // 1. Get all keys, cast to numbers, and find the maximum
    const patientIds = Object.keys(db.DPT).map(Number);
    const maxId = patientIds.length > 0 ? Math.max(...patientIds) : 0;

    // 2. Overwrite the out-of-sequence tracking value
    db.DIC.lastId = maxId;

    console.log(`TypeScript: Sequence repaired. Last ID set to ${maxId}`);
    return db;
}

// Example Usage
const currentDb: Database = {
    DPT: { 1: "Alice", 2: "Bob", 105: "Charlie" },
    DIC: { lastId: 2 } // Out of sync
};
fixSequence(currentDb);
